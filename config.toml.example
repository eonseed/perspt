# Perspt configuration (TOML)
#
# Copy this file to your platform config directory:
#   Linux:   ~/.config/perspt/config.toml
#   macOS:   ~/Library/Application Support/perspt/config.toml
#   Windows: %APPDATA%\perspt\config.toml
#
# Or point at it explicitly: `perspt --config ./config.toml chat`
# All fields are optional; missing values fall back to environment detection.

# Provider id: openai, anthropic, gemini, vertex, groq, cohere, ollama, xai, deepseek
provider = "openai"

# Default model for chat / simple-chat. Custom OpenAI-compatible names
# (e.g. "phi-4-npu-ov") are routed to the provider above.
model = "gpt-4o-mini"

# API key for the provider. May also be supplied via the provider's env var
# (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...).
# api_key = "sk-..."

# Optional endpoint override for OpenAI-compatible or local servers.
# You can also set OPENAI_BASE_URL / OLLAMA_BASE_URL etc. in the environment.
# base_url = "http://localhost:8000/v1"

# Vertex AI (Google Agent Platform) uses Google Cloud ADC by default.
# Configure provider/model and either set these fields or use
# VERTEX_PROJECT_ID / VERTEX_LOCATION in the environment.
# provider = "vertex"
# model = "vertex::<model-id>"
# vertex_project_id = "<gcp-project-id>"
# vertex_location = "<vertex-location>"

# Optional per-tier model overrides for `perspt agent`.
# architect_model = "gpt-4o"
# actuator_model = "gpt-4o-mini"
# verifier_model = "gpt-4o-mini"
# speculator_model = "gpt-4o-mini"

# ---------------------------------------------------------------------------
# PSP-9 model portfolio (several providers live in one process)
# ---------------------------------------------------------------------------
# Each [providers.<id>] entry is one credentialed route. The id is yours; the
# adapter defaults to the id. Provider records describe resolution policy,
# not embedded secrets: prefer api_key_env over a literal api_key.
#
# [providers.anthropic]
# api_key_env = "ANTHROPIC_API_KEY"
#
# [providers.openai]
# api_key_env = "OPENAI_API_KEY"
#
# [providers.local]
# adapter  = "ollama"
# base_url = "http://localhost:11434"
#
# Per-tier routes are fully qualified "provider::model" so identity,
# calibration, and replay never depend on an ambient default provider.
#
# [models]
# architect   = "anthropic::<model>"
# actuator    = "openai::<model>"
# verifier    = "anthropic::<model>"
# speculator  = "local::<model>"
# adjudicator = "openai::<model>"

# ---------------------------------------------------------------------------
# Optional shared MCP servers
# ---------------------------------------------------------------------------
# Servers are lazy: they start only after deferred discovery in an eligible
# mode. Omitted modes mean ["agent"]. Agent and chat always use separate
# process/session lifecycles and separately minted capabilities.
#
# [[external_tools]]
# id = "workspace-index"
# transport = "stdio"
# command = ["workspace-index-mcp", "--stdio"]
# modes = ["agent", "chat"]
# timeout_ms = 30000
# max_result_bytes = 1048576
# max_stderr_bytes = 65536
# env_from_env = { INDEX_TOKEN = "WORKSPACE_INDEX_TOKEN" }
#
# [external_tools.tools.search]
# effect = "data_read"
# risk = "low"
# footprint = { selectors = [{ kind = "scoped_argument", family = "index", field = "collection", access = "read" }] }
# proposal_bindings = [{ kind = "multi_value", field = "collections", target = "path" }]
#
# [[external_tools]]
# id = "records"
# transport = "streamable_http"
# url = "https://tools.example.test/mcp"
# modes = ["agent"]
# headers_from_env = { Authorization = "RECORDS_AUTHORIZATION" }

# ---------------------------------------------------------------------------
# Bounded search (PSP-10 system 20; sequential branches, hard cap 3)
#
# A failed attempt may open a bounded search forest at the refine rung:
# isolated eager-copy branches measured against the same accepted root,
# with exactly one candidate committed through the ordinary gate.
#
# [exploration]
# initial_branches = 1
# max_branches = 3
# distinct_family = true
# max_workspace_files = 300000
# max_workspace_bytes = 4294967296

# Prompt bundles and activation bounds (PSP-10 system 25)
#
# [prompts]
# bundles = []
# activation_min_tasks = 30       # floor 30; may only be raised
# noninferiority_margin = 0.05    # epsilon in [0, 0.05]

# ---------------------------------------------------------------------------
# After a gate failure, the recovery ladder's refine rung may draw one round
# of distinct-family proposers. Ensembles propose, never decide: every
# candidate runs the ordinary governed loop, consumes one gate decision, and
# selection is strictly by measured energy. `--ensemble-width N` enables the
# same policy from the command line.
#
# [ensemble]
# trigger = "after_gate_failure"   # or "never" (default)
# width = 2                        # candidates per round, max 4
# require_distinct_family = true
